# =============================================================================
# Translator Backend - Environment Configuration
# Copy this file to `.env` and adjust the values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=translator-backend
APP_VERSION=1.0.0
APP_PORT=3000
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta
# Enable the REST API HTTP server (set to false for a worker-only container)
ENABLE_HTTP=true
# Enable the RabbitMQ consumers (set to false for an API-only container)
ENABLE_WORKER=true
# Comma separated list of allowed origins, use * to allow every origin
CORS_ORIGINS=*
# Request body size limit (accepts bytes or express size notation, e.g. 1mb)
BODY_LIMIT=1mb

# -----------------------------------------------------------------------------
# Database (MySQL)
# -----------------------------------------------------------------------------
# Inside Docker use `mysql` (the infra stack of docker-compose.infra.yml) or
# `host.docker.internal` when MySQL is installed on the host server.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=mdi_translator
# Never turn this on in production, use migrations instead
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_CONNECTION_LIMIT=10

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Secret used to sign the admin/client access token (JWT)
JWT_SECRET=change-this-to-a-long-random-string
# Access token lifetime in seconds (86400 = 1 day)
JWT_EXPIRES_IN=86400
JWT_COOKIE_NAME=access_token
# Lifetime (seconds) of the HMAC token exchanged between client and translator
SIGNATURE_TOKEN_TTL=300
# Key used to encrypt every secret stored in the database (drivers.secret_key,
# account_keys.secret_key). MUST be identical across all running instances and
# should never be rotated without re-encrypting the stored secrets.
APP_ENCRYPTION_KEY=change-this-to-another-long-random-string
BCRYPT_ROUNDS=10

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_ENABLED=true
# Inside Docker use `rabbitmq` (docker-compose.infra.yml) or
# `host.docker.internal` when RabbitMQ is installed on the host server.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=translator
# Consumer prefetch, keep 1 to process one task at a time
RABBITMQ_PREFETCH=1
# Delay (ms) between reconnection attempts
RABBITMQ_RECONNECT_MS=5000
# Delay (ms) before a translate task is requeued (driver rate limit / failure)
TRANSLATE_RETRY_DELAY_MS=60000
# Maximum number of requeue attempts for a translate task
TRANSLATE_MAX_RETRY=5
# Delay (ms) before a failed callback is sent again (plan: 5 minutes)
CALLBACK_RETRY_DELAY_MS=300000
# Maximum callback delivery attempts (plan: fail once => requeue, fail twice => drop)
CALLBACK_MAX_ATTEMPTS=2
# HTTP timeout (ms) when delivering a callback
CALLBACK_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Translation engines
# -----------------------------------------------------------------------------
# Maximum characters accepted for a single translation request
TRANSLATION_MAX_CHARS=5000
# HTTP timeout (ms) for every provider request
TRANSLATION_TIMEOUT_MS=60000
# Optional extra instruction appended to the AI translation prompt
TRANSLATION_PROMPT_EXTRA=

# Google Gemini (driver id prefix: gemini-*)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta

# Anthropic Claude (driver id prefix: claude-*)
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=8192

# DeepSeek (driver id prefix: deepseek-*)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Google Cloud Translation API (driver id prefix: api-google-translate)
GOOGLE_TRANSLATE_BASE_URL=https://translation.googleapis.com/language/translate/v2
GOOGLE_TRANSLATE_FORMAT=text

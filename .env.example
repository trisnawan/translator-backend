NODE_ENV=development

APP_NAME=translator-backend
APP_VERSION=1.0.0
APP_PORT=3000
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta
APP_ENCRYPTION_KEY=

BCRYPT_ROUNDS=10
ENABLE_HTTP=true
ENABLE_WORKER=true
CORS_ORIGINS=*
BODY_LIMIT=1mb

DB_HOST=host.docker.internal
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=mdi_translator
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_CONNECTION_LIMIT=10

JWT_SECRET=
JWT_EXPIRES_IN=86400
JWT_COOKIE_NAME=access_token
SIGNATURE_TOKEN_TTL=300

RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@host.docker.internal:5672
RABBITMQ_EXCHANGE=translator
RABBITMQ_PREFETCH=1
RABBITMQ_RECONNECT_MS=5000

TRANSLATE_RETRY_DELAY_MS=60000
TRANSLATE_MAX_RETRY=5

CALLBACK_RETRY_DELAY_MS=300000
CALLBACK_MAX_ATTEMPTS=2
CALLBACK_TIMEOUT_MS=15000

TRANSLATION_MAX_CHARS=5000
TRANSLATION_TIMEOUT_MS=60000
TRANSLATION_PROMPT_EXTRA=

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta

ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=8192

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

GOOGLE_TRANSLATE_BASE_URL=https://translation.googleapis.com/language/translate/v2
GOOGLE_TRANSLATE_FORMAT=text

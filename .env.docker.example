# Environment used by the containers of `docker-compose.yml`
# (api / worker / migrate / seeder).
#
# MySQL and RabbitMQ are optional dependencies, they are not started by that
# file. Depending on where they run, adjust DB_HOST and RABBITMQ_URL below:
#   - containers of `docker-compose.infra.yml`  ->  mysql            / rabbitmq
#     (docker compose -f docker-compose.infra.yml up -d)
#   - installed on the operating system         ->  host.docker.internal
#   - another server / managed service          ->  db.example.com   / mq.example.com
NODE_ENV=production
APP_NAME=translator-backend
APP_VERSION=1.0.0
APP_PORT=3000
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta
ENABLE_HTTP=true
ENABLE_WORKER=true
CORS_ORIGINS=*
BODY_LIMIT=1mb

# mysql (container) | host.docker.internal (installed on the host) | other host
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=translator_root_password
DB_DATABASE=mdi_translator
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_CONNECTION_LIMIT=10

JWT_SECRET=9f2c1f0d7b6a4e8c5d3b2a1908f7e6d5c4b3a291807f6e5d4c3b2a190807f6e5
JWT_EXPIRES_IN=86400
JWT_COOKIE_NAME=access_token
SIGNATURE_TOKEN_TTL=300
APP_ENCRYPTION_KEY=3a7f9c1e5b8d2460a1f3c5e7b9d0f2468ace13579bdf02468ace13579bdf0246
BCRYPT_ROUNDS=10

RABBITMQ_ENABLED=true
# rabbitmq (container) | host.docker.internal (installed on the host) | other host
RABBITMQ_URL=amqp://translator:translator_pass@rabbitmq:5672
RABBITMQ_EXCHANGE=translator
RABBITMQ_PREFETCH=1
RABBITMQ_RECONNECT_MS=5000
TRANSLATE_RETRY_DELAY_MS=60000
TRANSLATE_MAX_RETRY=5
CALLBACK_RETRY_DELAY_MS=300000
CALLBACK_MAX_ATTEMPTS=2
CALLBACK_TIMEOUT_MS=15000

TRANSLATION_MAX_CHARS=5000
TRANSLATION_TIMEOUT_MS=60000
TRANSLATION_PROMPT_EXTRA=

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta

ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=8192

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

GOOGLE_TRANSLATE_BASE_URL=https://translation.googleapis.com/language/translate/v2
GOOGLE_TRANSLATE_FORMAT=text
